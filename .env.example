# Salesforce is read-only. Provide either a static token or the password grant.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# Gong MCP. Leave the tool name and argument unset until the tool contract is known.
GONG_MCP_URL=
GONG_MCP_TOKEN=
GONG_MCP_TOOL=
GONG_MCP_OPPORTUNITY_ARGUMENT=

# Optional. When set, empty sections are drafted with this model through the AI Gateway.
AI_GATEWAY_API_KEY=

# Optional override for the working-design file.
DESIGN_STORE_PATH=
