# Salesforce is read-only. Provide either a static token or the password grant.
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=

# Access token from the existing Gong MCP connection at https://mcp.gong.io/mcp.
# Empty sections call ask_deal with the Salesforce opportunity id.
GONG_MCP_TOKEN=
# Optional. Defaults to https://mcp.gong.io/mcp
GONG_MCP_URL=

# Optional. When set, empty sections are drafted with this model through the AI Gateway.
AI_GATEWAY_API_KEY=

# Optional override for the working-design file.
DESIGN_STORE_PATH=
